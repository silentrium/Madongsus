{
  "builds": [
    {
      "src": "extract.py",
      "use": "@vercel/python"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/extract",
      "dest": "extract.py"
    },
    {
      "src": "/ai-metadata",
      "dest": "extract.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
